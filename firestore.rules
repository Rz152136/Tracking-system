rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && myRole() == 'King';
    }

    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myRole() in ['IE', 'Record', 'King'];
    }

    match /productions/{entryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myRole() in ['IE', 'Operator', 'King'];
    }

    match /packing/{entryId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && myRole() in ['IE', 'Operator', 'King'];
    }
  }
}
